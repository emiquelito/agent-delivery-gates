{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "ADG_PHASE=\"${ADG_PHASE:-build}\" node \"$CLAUDE_PROJECT_DIR/hooks/pre-mutation-clean-tree.ts\" || exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/test-diff-post-tool-hook.ts\" || exit 2"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/delivery-report-stop-hook.ts\" || exit 2"
          }
        ]
      }
    ]
  }
}

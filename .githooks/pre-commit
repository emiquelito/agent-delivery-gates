#!/usr/bin/env bash
# Git pre-commit hook. Not run automatically until a person turns it on with:
#
#   git config core.hooksPath .githooks
#
# Runs, in order: the typecheck, the test suite, the prose scan, and the
# tally check. Stops at the first failure, prints which check failed and the
# exact command to run it alone, and exits non-zero so the commit does not
# happen.
#
# Deliberate exception: set ADG_SKIP_PRECOMMIT=1 to skip this hook for one
# commit. The skip is never quiet; it prints loudly to say so.
set -euo pipefail

if [ -n "${ADG_SKIP_PRECOMMIT:-}" ]; then
  echo "=============================================================="
  echo " pre-commit: SKIPPED because ADG_SKIP_PRECOMMIT is set."
  echo " None of the usual checks ran for this commit. Unset"
  echo " ADG_SKIP_PRECOMMIT to run them again next time."
  echo "=============================================================="
  exit 0
fi

# Strip every GIT_* override before running git, the same reason
# scripts/pre-publication-check.sh does: a leftover GIT_DIR or
# GIT_WORK_TREE would point git at a different tree than the one being
# committed.
while IFS='=' read -r -d '' entry; do
  name=${entry%%=*}
  case "$name" in
    GIT_*) unset "$name" ;;
  esac
done < <(env -0)

if ! ROOT=$(git rev-parse --show-toplevel 2>&1); then
  echo "pre-commit: not a git repository. git said: $ROOT" >&2
  exit 2
fi
cd "$ROOT"

# Output is held back and printed only when a step fails. A hook that prints
# tens of thousands of lines on a good commit is one people turn off, and a
# gate nobody runs catches nothing.
LOG=$(mktemp)
trap 'rm -f "$LOG"' EXIT

fail_step() {
  echo "==============================================================" >&2
  echo " pre-commit: FAILED at: $1" >&2
  echo " Run it alone with:" >&2
  echo "   $2" >&2
  echo "==============================================================" >&2
  cat "$LOG" >&2
  exit 1
}

run_step() {
  local label=$1 command=$2
  shift 2
  printf 'pre-commit: %s\n' "$label"
  if ! "$@" >"$LOG" 2>&1; then
    fail_step "$label" "$command"
  fi
}

run_step "typecheck" "npx tsc --noEmit" npx tsc --noEmit

run_step "tests" "npm test" npm test

run_step "prose scan" "scripts/scan-prose.sh" scripts/scan-prose.sh

run_step "tally check" "node scripts/tally-report.ts --check" node scripts/tally-report.ts --check

echo "pre-commit: all checks passed"
exit 0
